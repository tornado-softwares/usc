type fuckyou_success = {max:number; min:number; success: true;};
type fuckyou_error = {message:string;  success:false;};
type fuckyou_output = fuckyou_success or fuckyou_error;

function fuckyou():fuckyou_output {
	const max:number = 1;
	const min:number = 1;
	if(true){
		return {message:"Erreur inconnnue blabla", success:false};
	}
	return {max:max, min:min, success:true};
}

const shit:fuckyou_output = fuckyou();

if (shit.success == true){
	const output:fuckyou_success = shit;
} else {
	const output:fuckyou_error = shit;
}
